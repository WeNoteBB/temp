# PET 精读后端 · 环境变量
# 复制成 .env 再改（.env 不进 git）：
#     cp .env.example .env
#
# 本地联调： npm run start:env       （server 目录里跑）
# 服务器上： systemd 用 /opt/pet-api/.env，由 deploy/api-server-setup.sh 生成

# ---------- MySQL（bud 库） ----------
# ⚠ zhang 这个账号要在 MySQL 里允许「本机/这台服务器的 IP」连，否则报
#   Access denied。部署后先跑一遍： node --env-file=.env selftest.mjs
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=zhang
DB_PASS=在这里填密码
DB_NAME=bud

# ---------- 服务 ----------
# 端口：生产由 nginx 把 /api/ 反代到它，只监听 127.0.0.1 就够
PORT=3001
HOST=127.0.0.1
# 收藏写进 user_word / user_sentence 的 level 字段（你定的：PET）
PET_LEVEL=PET
# 收藏来源类型（user_word.source_type 注释：1=课程 2=文章 3=视频）
SOURCE_TYPE=2

# 本地想用别的静态站点目录联调时才需要（默认 ../dist，一般不动）
# DIST_DIR=../dist

# 允许跨域调用的来源（比如用 python http.server 在 8899 端口开 dist/ 时）。
# 默认不开——正常部署是同源 /api，用不到。
# CORS_ORIGIN=http://localhost:8899

{
  "name": "pet-reading",
  "version": "1.0.0",
  "description": "PET 精读 · 多文章引擎",
  "scripts": {
    "build": "node build.mjs",
    "verify": "node tools/verify.mjs",
    "smoke": "node tools/smoke.mjs",
    "test:store": "node tools/test-store.mjs",
    "server": "node server/server.mjs",
    "test:server": "node server/test.mjs",
    "videos:dry": "node tools/import-videos.mjs --dry",
    "videos:sql": "node tools/import-videos.mjs --sql --out server/video-seed.sql",
    "import:videos": "node --env-file=server/.env tools/import-videos.mjs --write",
    "prepare:videos": "node tools/prepare-videos.mjs",
    "check": "node tools/verify.mjs && node build.mjs && node tools/smoke.mjs && node tools/test-store.mjs"
  },
  "type": "module",
  "private": "true",
  "devDependencies": {
    "jsdom": "^30.1.2",
    "msedge-tts": "^2.1.0"
  }
}
